<root>
  <styles>
    <include src="s2r://panorama/styles/custom_game/prac_hud.vcss_c" />
  </styles>

  <!--
    PracLab 练习 HUD（CCSCustomHudLayout 受限资源模型：纯 VXML/VCSS，无 VJS/HTML/audio）。

    服务器 -> HUD 协议（与 C# 侧 Commands/PracticeHud 保持一致）：
      dialog variables（{s:name} 引用，由 SetDialogVariableStringForPlayer 逐玩家推送）：
        strafe-panel : strafe-title / strafe-label / strafe-diff / strafe-stats
        shot-panel   : shot-title   / shot-label   / shot-error  / shot-stats
        sync-panel   : sync-title   / sync-current / sync-avg    / sync-best
      CSS classes（由 SetHasClassForPlayer 逐玩家切换）：
        strafe-panel : hidden，判定色钩子 strafe-perfect / strafe-good / strafe-bad，
                       位置钩子 pos-r{0..2}c{0..2}（九宫格），选中钩子 move-selected
        shot-panel   : hidden + pos-* / move-selected
        sync-panel   : hidden + pos-* / move-selected
        hudmove-grid : hidden（移动编辑模式网格，3×3 九宫格）
      结构注意：
      - 根面板不允许携带 id（CCSCustomHudLayout 编译约束），根面板恒显示、恒不拦截输入，
        显隐全部由子面板的 hidden class 控制；
      - Button 类型面板不允许携带 hittest 属性（客户端 CustomHud 校验失败会导致整个布局
        不渲染），Button 默认即可点击，无需显式声明；
      - 功能面板保持 Panel 元素（SetHasClassForPlayer 按面板 id 操作 per-player class），
        面板内容包裹在恒显示的内嵌 Button（*-select）中供 .hudmove 编辑模式点击选中——
        输入捕获关闭时无鼠标指针，按钮不会误触；
      - 弹道追踪（.recoil）无 HUD 面板：压枪轨迹仅以世界空间 beam 绘制（复用 .nadedraw 基建）。
    所有面板初始折叠（hidden），由服务器按玩家逐个显示。
  -->
  <Panel class="PracHudRoot" hittest="false">
    <!-- 急停评估：同轴移动键切换时序判定 -->
    <Panel id="strafe-panel" class="PracHudPanel hidden">
      <Button id="strafe-select" class="PracHudSelectArea">
        <Label class="PracHudTitle" text="{s:strafe-title}" hittest="false" />
        <Label class="PracHudVerdict" text="{s:strafe-label}" hittest="false" />
        <Label class="PracHudDetail" text="{s:strafe-diff}" hittest="false" />
        <Label class="PracHudStats" text="{s:strafe-stats}" hittest="false" />
      </Button>
    </Panel>

    <!-- 开枪稳定：IN_ATTACK 边沿水平速度误差 -->
    <Panel id="shot-panel" class="PracHudPanel hidden">
      <Button id="shot-select" class="PracHudSelectArea">
        <Label class="PracHudTitle" text="{s:shot-title}" hittest="false" />
        <Label class="PracHudVerdict" text="{s:shot-label}" hittest="false" />
        <Label class="PracHudDetail" text="{s:shot-error}" hittest="false" />
        <Label class="PracHudStats" text="{s:shot-stats}" hittest="false" />
      </Button>
    </Panel>

    <!-- 空中同步：空中 strafe 同步率 -->
    <Panel id="sync-panel" class="PracHudPanel hidden">
      <Button id="sync-select" class="PracHudSelectArea">
        <Label class="PracHudTitle" text="{s:sync-title}" hittest="false" />
        <Label class="PracHudVerdict" text="{s:sync-current}" hittest="false" />
        <Label class="PracHudDetail" text="{s:sync-avg}" hittest="false" />
        <Label class="PracHudStats" text="{s:sync-best}" hittest="false" />
      </Button>
    </Panel>

    <!-- 移动编辑模式网格（3×3 九宫格；.hudmove 选中面板后显示；容器不拦截输入，仅格子可点） -->
    <Panel id="hudmove-grid" class="HudMoveGrid hidden" hittest="false">
      <Panel class="HudMoveRow" hittest="false">
        <Button id="hudmove-slot-r0c0" class="HudMoveSlot" />
        <Button id="hudmove-slot-r0c1" class="HudMoveSlot" />
        <Button id="hudmove-slot-r0c2" class="HudMoveSlot" />
      </Panel>
      <Panel class="HudMoveRow" hittest="false">
        <Button id="hudmove-slot-r1c0" class="HudMoveSlot" />
        <Button id="hudmove-slot-r1c1" class="HudMoveSlot" />
        <Button id="hudmove-slot-r1c2" class="HudMoveSlot" />
      </Panel>
      <Panel class="HudMoveRow" hittest="false">
        <Button id="hudmove-slot-r2c0" class="HudMoveSlot" />
        <Button id="hudmove-slot-r2c1" class="HudMoveSlot" />
        <Button id="hudmove-slot-r2c2" class="HudMoveSlot" />
      </Panel>
    </Panel>
  </Panel>
</root>
